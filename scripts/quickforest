#!/usr/bin/env python3
"""quickforest {optimize|prune|compile|check|structure} ...  (each subcommand is its own script; --help on each)"""

import runpy
import sys
from pathlib import Path

HERE = Path(__file__).resolve().parent
COMMANDS = ("optimize", "prune", "compile", "check", "structure")

if len(sys.argv) == 2 and sys.argv[1] in ("--help", "-h", "help"):
    print(__doc__)  # a request for the usage is not a failure: stdout, exit 0
    sys.exit(0)
if len(sys.argv) < 2 or sys.argv[1] not in COMMANDS:
    sys.exit(__doc__)
sys.argv = [sys.argv[1], *sys.argv[2:]]
sys.path.insert(0, str(HERE))
runpy.run_path(str(HERE / f"{sys.argv[0]}.py"), run_name="__main__")
